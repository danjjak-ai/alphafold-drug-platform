# .gcloudignore
# -----------------------------------------------------------------------------
# 불필요한 파일 업로드 방지 (빌드 속도 및 보안 향상)
# -----------------------------------------------------------------------------

# Git
.git/
.gitignore

# Python 관련
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# 데이터 및 모델 (용량이 너무 큰 파일만 제외하고 나머지는 허용)
# data/
# results/
# vina_bin/

# Allow all docking outputs and structures to match local dashboard exactly
!results/docking/
!results/docking/*.pdbqt
!results/docking/*.txt
!data/structures/targets/*.pdb

# 로컬 설정
.env
.vscode/
.idea/

# 로그 및 임시 파일
*.log
tmp/
temp/

# 기동 스크립트
*.bat
*.sh
implementation_plan.md
research.md
plan.md
walkthrough.md
task.md
